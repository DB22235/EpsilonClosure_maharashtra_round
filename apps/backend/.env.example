# Application
APP_ENV=development
APP_NAME=fair-drop
API_V1_PREFIX=/api/v1

# Database (added in Step 2)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fairdrop

# Redis (optional, added when needed)
REDIS_URL=

# Supabase Auth (added in Step 3)
# Project URL: https://gjbijluacysjudkvpivd.supabase.co
SUPABASE_URL=https://gjbijluacysjudkvpivd.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
EMAIL_HASH_PEPPER=fair-drop-dev-pepper-change-me

# Signing keys for admission permits and entitlements (added in Step 5)
SIGNING_KEY_ID=fair-drop-dev-key-1
SIGNING_PRIVATE_KEY=

# Server-authoritative timers (seconds)
IDLE_SESSION_SECONDS=120
ABSOLUTE_REDEMPTION_SECONDS=300
SEAT_HOLD_SECONDS=120
COOLDOWN_SECONDS=300
MAX_CHALLENGE_ATTEMPTS=2

# CORS
CORS_ORIGINS=["http://localhost:3000"]
