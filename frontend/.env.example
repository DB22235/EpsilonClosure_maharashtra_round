# ==============================================================================
# FairDrop Frontend Environment Configuration Template
# Copy this file to .env.local and update with your local/staging configuration:
#   cp .env.example .env.local
# ==============================================================================

# Supabase Project URL & Anon Key (matches backend settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# FastAPI Backend Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Demo Mode Toggle (false = connect to live FastAPI backend)
NEXT_PUBLIC_DEMO_MODE=false
